{
  "name": "expbuild-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check:lockfiles": "node tools/check-lockfile-registry.mjs",
    "test:client-profiles": "node --test tests/contracts/client-profiles.test.mjs",
    "test:lockfiles": "node --test tools/check-lockfile-registry.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.9"
  }
}
